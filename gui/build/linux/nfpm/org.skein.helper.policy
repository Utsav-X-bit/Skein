<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- pkexec selects this action by exec.path, not a command-line action flag.
     One executable has one policy; the helper validates its fixed verbs.
     No cached authorization, inactive/remote sessions denied. -->
<policyconfig>
  <action id="org.skein.helper.control">
    <description>Manage the Skein system service and local access</description>
    <message>Authentication is required for this Skein service or access change. The desktop remains unprivileged.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/skein-helper</annotate>
  </action>
</policyconfig>
